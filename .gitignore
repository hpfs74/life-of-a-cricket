.DS_Store
node_modules/

# Xcode / SwiftPM local state. Regenerated on demand; never shared.
# xcuserdata carries per-developer schemes and breakpoints, and Xcode will
# also rewrite project.pbxproj with a local DEVELOPMENT_TEAM if allowed to.
.build/
.swiftpm/
# Unanchored: these appear nested under swift/, and a pattern containing a
# slash is anchored to this file's directory unless it starts with **/.
**/xcuserdata/
**/project.xcworkspace/
DerivedData/
